<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="SistemaEducativo.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:view="clr-namespace:SistemaEducativo.View"
    Title="Seguimiento de estudiantes"
    FlyoutBehavior="Locked">

    <!-- Cada FlyoutItem es un botón del menú lateral. Su ShellContent es la página que se abre. -->
    <FlyoutItem Title="Inicio / Comisión" Route="MainPage">
        <ShellContent ContentTemplate="{DataTemplate view:MainPage}" />
    </FlyoutItem>
	<FlyoutItem Title="Nómina (H1)" Route="NominaPage">
		<ShellContent ContentTemplate="{DataTemplate view:NominaPage}" />
	</FlyoutItem>
    <FlyoutItem Title="Calendario(H2)" Route="CalendarioPage">
        <ShellContent ContentTemplate="{DataTemplate view:CalendarioPage}"/>
    </FlyoutItem>
    <FlyoutItem Title="Asistencia(H3)" Route="AsistenciaPage">
        <ShellContent ContentTemplate="{DataTemplate view:AsistenciaPage}"/>
    </FlyoutItem>
    <FlyoutItem Title="Trabajos(H2)" Route="TrabajoPage">
        <ShellContent ContentTemplate="{DataTemplate view:TrabajoPage}"/>
    </FlyoutItem>
    <FlyoutItem Title="Riesgo(H6)" Route="RiesgoPage">
        <ShellContent ContentTemplate="{DataTemplate view:RiesgoPage}"/>
    </FlyoutItem>
</Shell>
