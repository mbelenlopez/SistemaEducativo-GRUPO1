<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodel="clr-namespace:SistemaEducativo.ViewModel"
    x:Class="SistemaEducativo.View.RiesgoPage"
    x:DataType="viewmodel:RiesgoViewModel"
    BackgroundColor="#F7F9FC"
    Title="Panel de riesgo">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="15">
            <Label Text="PANEL DE RIESGO" Style="{StaticResource TituloPagina}" />
            <Label Text="{Binding UmbralesTexto}" Style="{StaticResource Subtitulo}" />
			<Label Text="Hace clic en un estudiante para ver su ficha." Style="{StaticResource Subtitulo}" />
			
            <Button Text="↻ Recalcular riesgo" Command="{Binding RecalcularCommand}" Style="{StaticResource PrimaryButton}" HorizontalOptions="Start" />
            <Label Text="{Binding Mensaje}" Style="{StaticResource MensajeEstado}" />

            <Border Style="{StaticResource ItemTarjeta}" Padding="20" BackgroundColor="#E8F0FE">
                <VerticalStackLayout Spacing="5">
                    <Label Text="Resumen de la Comisión" FontAttributes="Bold" FontSize="16" TextColor="#1A73E8"/>
                    <Label Text="{Binding ResumenRiesgoTexto}" FontSize="24" />
                    <Label Text="Estudiantes en riesgo de abandonar."  FontAttributes="Bold" />
                </VerticalStackLayout>
            </Border>

            <CollectionView ItemsSource="{Binding Items}" SelectionMode="Single" SelectionChanged="OnEstudianteSeleccionado">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="viewmodel:PanelItem">
                        <Border Style="{StaticResource ItemTarjeta}" Padding="15">
                            <Grid ColumnDefinitions="2*,*,*,Auto,140" ColumnSpacing="15">
                                <Label Text="{Binding NombreCompleto}" FontAttributes="Bold" VerticalOptions="Center" />

                                <Label Grid.Column="1" Text="{Binding InasistenciasTexto}" VerticalOptions="Center" />

                                <Label Grid.Column="2" Text="{Binding EntregaTexto}" VerticalOptions="Center" />

                                <Label Grid.Column="3" Text="{Binding NivelTexto}" FontAttributes="Bold" VerticalOptions="Center" />

                                <!-- NUEVO H11: Columna fija de 140 de ancho, texto alineado a la derecha -->
                                <Label Grid.Column="4" 
                                        Text="{Binding ContactoTexto}" 
                                        FontSize="12" 
                                        TextColor="#6B7280" 
                                        HorizontalTextAlignment="End" 
                                        VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>