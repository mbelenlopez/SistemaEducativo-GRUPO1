<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="SistemaEducativo.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:view="clr-namespace:SistemaEducativo.View"
    Title="Seguimiento de estudiantes"
    FlyoutBehavior="Locked">

    <!-- Cada FlyoutItem es un botón del menú lateral. Su ShellContent es la página que se abre. -->
    <FlyoutItem Title="⌂   Inicio / Comisión" Route="MainPage">
        <ShellContent ContentTemplate="{DataTemplate view:MainPage}" />
    </FlyoutItem>
	<FlyoutItem Title="👥   Nómina (H1)" Route="NominaPage">
		<ShellContent ContentTemplate="{DataTemplate view:NominaPage}" />
	</FlyoutItem>
</Shell>
