<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:SistemaEducativo.ViewModel"
             xmlns:entidades="clr-namespace:SistemaEducativo.Entidades"
             x:DataType="viewmodel:CalendarioViewModel"
             x:Class="SistemaEducativo.View.CalendarioPage"
             BackgroundColor="#F7F9FC"
             Title="Calendario">
    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="15">
            <Label 
                Text="CALENDARIO DE LA COMISIÓN"
                Style="{StaticResource TituloPagina}"
                VerticalOptions="Center" 
                HorizontalOptions="Center" />
            <Label
                Text="{Binding Sesion.ComisionActualNombre, StringFormat='Comisión: {0}'}"
                Style="{StaticResource Subtitulo}"/>

            <Border Style="{StaticResource Tarjeta}">
                <HorizontalStackLayout Spacing="12">
                    <DatePicker Date="{Binding Fecha}"/>
                    <Button
                        Text="+ Registrar clase"
                        Command="{Binding AgregarCommand}"
                        Style="{StaticResource PrimaryButton}"/>
                </HorizontalStackLayout>
            </Border>

            <Label
                Text="{Binding Mensaje}"
                Style="{StaticResource MensajeEstado}"/>

            <CollectionView 
                ItemsSource="{Binding Clases}" 
                SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="entidades:Clase">
                        <Border Style="{StaticResource ItemTarjeta}">
                            <Grid ColumnDefinitions="*, Auto">
                                <Label
                                    Text="{Binding FechaFormateada}"
                                    FontSize="16"
                                    FontAttributes="Bold"/>
                                <Label
                                    Grid.Column="1"
                                    Text="CLASE"
                                    TextColor="#2563EB"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
