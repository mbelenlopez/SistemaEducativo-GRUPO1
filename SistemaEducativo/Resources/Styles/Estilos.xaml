<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Botones -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="#2563EB" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="16,10" />
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="#E9EEF7" />
        <Setter Property="TextColor" Value="#26364A" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="16,10" />
    </Style>

    <!-- Textos -->
    <Style x:Key="TituloPagina" TargetType="Label">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="#172033" />
    </Style>

    <Style x:Key="Subtitulo" TargetType="Label">
        <Setter Property="TextColor" Value="#6B7788" />
    </Style>

    <Style x:Key="MensajeEstado" TargetType="Label">
        <Setter Property="TextColor" Value="#2563EB" />
    </Style>

    <!-- Tarjetas -->
    <Style x:Key="Tarjeta" TargetType="Border">
        <Setter Property="BackgroundColor" Value="#FFFFFF" />
        <Setter Property="Stroke" Value="#E1E7F0" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="20" />
    </Style>

    <Style x:Key="ItemTarjeta" TargetType="Border">
        <Setter Property="BackgroundColor" Value="#FFFFFF" />
        <Setter Property="Stroke" Value="#E5EAF2" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="Margin" Value="0,0,0,7" />
    </Style>
</ResourceDictionary>
